{
    "manifest_version": 2,
    "name": "Lock In",
    "version": "1.0.0",
    "description": "Lock In — zero-knowledge password manager browser extension",

    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },

    "browser_action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "48": "icons/icon-48.png"
        },
        "default_title": "Lock In"
    },

    "background": {
        "page": "background/background.html"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content/autofill.js"],
            "run_at": "document_idle",
            "all_frames": false
        }
    ],

    "permissions": [
        "cookies",
        "storage",
        "tabs",
        "activeTab",
        "notifications",
        "http://localhost/*",
        "https://localhost/*"
    ],

    "browser_specific_settings": {
        "gecko": {
            "id": "lockin@lockin.app",
            "strict_min_version": "109.0"
        }
    }
}
